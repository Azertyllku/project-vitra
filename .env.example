# Copier vers .env.local (jamais commité). Valeurs dans Supabase > Project Settings > API.

# --- Publiques (visibles par le navigateur, protégées par la RLS) ---
NEXT_PUBLIC_SUPABASE_URL=https://ugkgaqsxbyxzuoumilkm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_t6VFCzvJYjz-CEF81vBEPw_PjPuOOtd
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Adresse de contact affichée sur la page de confidentialité (exercice des droits). Facultatif mais recommandé avant l'ouverture publique.
NEXT_PUBLIC_CONTACT_EMAIL=

# Développement derrière un proxy / tunnel / Codespaces / IP locale : hôtes autorisés pour les
# Server Actions, séparés par des virgules (ex. mon-site.app.github.dev,192.168.1.20:3000).
# Laisser vide si vous ouvrez le site via http://localhost:3000.
NEXT_ALLOWED_ORIGINS=

# --- SECRÈTES : serveur uniquement. NE JAMAIS préfixer par NEXT_PUBLIC_ ---
# Obligatoire pour la connexion des comptes de jeu (marque un compte comme vérifié) et la suppression de compte.
SUPABASE_SERVICE_ROLE_KEY=

# Connexion des comptes de jeu (voir docs/ACCOUNT_CONNECTIONS.md). Steam fonctionne sans clé.
# Facultatif : affiche le pseudo Steam au lieu de l'identifiant numérique.
STEAM_API_KEY=
# Riot Games (RSO), Battle.net et Epic Games : clés d'application à demander aux fournisseurs.
RIOT_CLIENT_ID=
RIOT_CLIENT_SECRET=
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
